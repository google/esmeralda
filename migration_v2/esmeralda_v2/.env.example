# ===========================================================================
# Esmeralda v2: Local Environment Configuration (.env)
# ===========================================================================
# Copy this file to '.env' and populate with your local overrides.
# Do NOT commit '.env' to version control!

# --- Google Cloud Project Configuration ---
# Your active Google Cloud Project ID used for authentication
GCP_PROJECT_ID=esmeralda-dev-workloads

# The GCP region for reasoning engines and serverless runtimes
GCP_REGION=us-central1

# --- Local MCP Server Port Allocations ---
# Ports used when running 'make run-mcp-local' to avoid conflict on localhost
PORT_CORPORATE_EMAIL=8001
PORT_INCOME_VERIFICATION=8002
PORT_LEGACY_DMS=8003

# --- Local Agent Settings ---
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Vertex AI Reasoning Engine ID (once deployed, for remote tests)
# REMOTE_AGENT_ENGINE_ID=projects/esmeralda-dev-workloads/locations/us-central1/reasoningEngines/1234567890
