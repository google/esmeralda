# ===========================================================================
# Esmeralda v2: Git Ignore Specifications
# ===========================================================================

# --- Local Python Virtual Environments & Packages ---
.venv/
.venv*
venv/
env/
.uv/

# --- Python Bytecodes & Cache Files ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- Local Credentials & Environment Variables ---
.env
.env.*
!.env.example
*.tfvars
*.tfvars.json

# --- Test and Evaluation Results ---
tests/load_test/.results/



# --- Terraform & Terragrunt Run Caches ---
.terraform/
.terragrunt-cache/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfplan
.local_states/
.terraform.lock.hcl

# --- System and IDE Overrides ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-*
*.swp
*.swo
docs/evaluation-improvement/
links.txt

# Agent Gateway / private CA material is fetched at build time from Secret Manager; never commit it
*.crt
*.pem
**/certs/

# Local record written by apps/services/register_mcp.py on each MCP deploy (env-specific)
apps/services/mcp_registry.json

# Generated by `make build-*` from uv.lock (uv export); the workspace uv.lock is the source of truth
apps/**/requirements.lock

# MkDocs build output (make docs-build)
site/
