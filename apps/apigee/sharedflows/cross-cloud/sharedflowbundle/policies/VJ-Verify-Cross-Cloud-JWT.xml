<VerifyJWT name="VJ-Verify-Cross-Cloud-JWT" continueOnError="false" enabled="true">
  <DisplayName>VJ-Verify-Cross-Cloud-JWT</DisplayName>
  <Algorithm>RS256</Algorithm>
  <Source>request.header.x-cross-cloud-token</Source>
  <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
  <PublicKey>
    <JWKS uriRef="crosscloud.jwks_uri"/>
  </PublicKey>
  <Issuer ref="crosscloud.issuer_uri"/>
  <Audience ref="crosscloud.audience"/>
</VerifyJWT>
