<RaiseFault name="RF-Cross-Cloud-Invalid-Token" continueOnError="false" enabled="true">
  <DisplayName>RF-Cross-Cloud-Invalid-Token</DisplayName>
  <FaultResponse>
    <Set>
      <StatusCode>401</StatusCode>
      <Payload contentType="application/json">{"error":"cross_cloud_invalid_token","detail":"Cross-cloud JWT verification failed or token is missing required iss/sub claims."}</Payload>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
