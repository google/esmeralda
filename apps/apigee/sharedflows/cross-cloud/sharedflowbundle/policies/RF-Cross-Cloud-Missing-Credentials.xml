<RaiseFault name="RF-Cross-Cloud-Missing-Credentials" continueOnError="false" enabled="true">
  <DisplayName>RF-Cross-Cloud-Missing-Credentials</DisplayName>
  <FaultResponse>
    <Set>
      <StatusCode>401</StatusCode>
      <Payload contentType="application/json">{"error":"cross_cloud_missing_credentials","detail":"Both x-cross-cloud-issuer and x-cross-cloud-token headers are required for cross-cloud authentication."}</Payload>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
