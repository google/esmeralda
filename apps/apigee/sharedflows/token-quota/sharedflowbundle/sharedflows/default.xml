<SharedFlow name="default">
  <Step>
    <Name>LTQ-enforce</Name>
    <Condition>(flow.apigee.token_quota.phase = "enforce") or (flow.apigee.token_quota.phase Is null)</Condition>
  </Step>
  <Step>
    <Name>LTQ-count</Name>
    <Condition>(flow.apigee.token_quota.phase = "count") and (llm.totalTokenCount != null)</Condition>
  </Step>
</SharedFlow>
