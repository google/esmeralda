<AssignMessage name="AM-clean-headers" continueOnError="false" enabled="true">
  <DisplayName>AM-clean-headers</DisplayName>
  <!-- Strips partner API key credentials before forwarding upstream while
       preserving X-Forwarded-Authorization and W3C traceparent headers. -->
  <Remove>
    <Headers>
      <Header name="x-api-key"/>
    </Headers>
  </Remove>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
