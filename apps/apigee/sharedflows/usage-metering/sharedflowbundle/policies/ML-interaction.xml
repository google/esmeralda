<MessageLogging name="ML-interaction" continueOnError="true" enabled="true">
  <DisplayName>ML-interaction</DisplayName>
  <!-- One esmeralda.usage record (contracts/usage-event.schema.json) per metered interaction, in
       PostClientFlow. caller.principal is the verified Apigee developer app name (never the API
       key). The usage.*_fields fragments come from JS-Usage-Context (run by this shared flow):
       each is empty or ends with a comma. Never logs request or response bodies, so SSE streams
       are never buffered and sensitive payloads never enter gateway logs. -->
  <CloudLogging>
    <LogName>projects/{organization.name}/logs/esmeralda-apigee-interactions</LogName>
    <Message contentType="application/json">{
  "schema": "esmeralda.usage",
  "schema_version": 1,
  "event": "gateway.request",
  "source": "gateway",
  "timestamp": "{usage.timestamp}",
  {usage.trace_fields}{usage.caller_fields}{usage.workload_fields}{usage.gen_ai_fields}{usage.outcome_fields}"gateway": {"product": "apigee", "name": "{apiproxy.name}"},
  "dimensions": {},
  "latency_ms": {firstnonnull(usage.latency_ms,'0')}
}</Message>
    <ResourceType>api</ResourceType>
  </CloudLogging>
</MessageLogging>
