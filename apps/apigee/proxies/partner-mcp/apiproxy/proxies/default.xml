<ProxyEndpoint name="default">
  <Description>North-south partner front door for MCP tool servers via the internal entrypoint with server-side tool scope enforcement.</Description>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>AM-Strip-Verified-Headers</Name>
      </Step>
      <Step>
        <Name>VAK-Verify-Partner-Key</Name>
      </Step>
      <Step>
        <Name>FC-Cross-Cloud</Name>
        <Condition>(request.header.x-cross-cloud-issuer != null) or (request.header.x-cross-cloud-token != null) or (verifyapikey.VAK-Verify-Partner-Key.apiproduct.requires_cross_cloud = "true") or (verifyapikey.VAK-Verify-Partner-Key.app.requires_cross_cloud = "true")</Condition>
      </Step>
      <Step>
        <Name>RF-Key-Identity-Mismatch</Name>
        <Condition>(verifyapikey.VAK-Verify-Partner-Key.app.owner_identity != null) and (verifyapikey.VAK-Verify-Partner-Key.app.owner_identity != "") and (request.header.x-verified-identity != null) and (request.header.x-verified-identity != "") and (verifyapikey.VAK-Verify-Partner-Key.app.owner_identity != request.header.x-verified-identity)</Condition>
      </Step>
      <Step>
        <Name>AM-set-user-var</Name>
      </Step>
      <Step>
        <Name>KVM-Get-MCP-Config</Name>
      </Step>
      <Step>
        <Name>JS-Enforce-Tool-Scope</Name>
      </Step>
      <Step>
        <Name>RF-Not-Found</Name>
        <Condition>mcp.service.allowed != true</Condition>
      </Step>
      <Step>
        <Name>RF-Tool-Forbidden</Name>
        <Condition>mcp.tool.forbidden = true</Condition>
      </Step>
      <Step>
        <Name>AM-clean-headers</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <Flows>
    <Flow name="mcpJsonRpc">
      <Description>Streamable HTTP MCP endpoint (/&lt;service&gt;/mcp)</Description>
      <Request/>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/*/mcp") and ((request.verb = "POST") or (request.verb = "GET") or (request.verb = "DELETE"))</Condition>
    </Flow>
    <Flow name="notFound">
      <Description>Catch-all 404 for unknown paths or HTTP methods</Description>
      <Request>
        <Step>
          <Name>RF-Not-Found</Name>
        </Step>
      </Request>
      <Response/>
    </Flow>
  </Flows>
  <HTTPProxyConnection>
    <BasePath>/partner/v1/mcp</BasePath>
    <Properties>
      <Property name="response.streaming.enabled">true</Property>
      <Property name="api.timeout">300000</Property>
    </Properties>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
  <PostClientFlow name="PostClientFlow">
    <Response>
      <Step>
        <Name>ML-interaction</Name>
      </Step>
    </Response>
  </PostClientFlow>
</ProxyEndpoint>
