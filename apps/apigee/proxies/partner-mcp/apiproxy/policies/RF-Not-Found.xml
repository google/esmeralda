<RaiseFault name="RF-Not-Found" continueOnError="false" enabled="true">
  <DisplayName>RF-Not-Found</DisplayName>
  <FaultResponse>
    <Set>
      <StatusCode>404</StatusCode>
      <Payload contentType="application/json">{"error":"not_found","detail":"Unknown partner MCP service path or HTTP method."}</Payload>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
