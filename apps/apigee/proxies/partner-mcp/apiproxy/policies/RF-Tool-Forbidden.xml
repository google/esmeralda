<RaiseFault name="RF-Tool-Forbidden" continueOnError="false" enabled="true">
  <DisplayName>RF-Tool-Forbidden</DisplayName>
  <FaultResponse>
    <Set>
      <StatusCode>403</StatusCode>
      <Payload contentType="application/json">{"error":"tool_forbidden","detail":"The requested MCP tool is not permitted by this API product's allowed_mcp_tools scope.","tool":"{mcp.tool.name}"}</Payload>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
