<RaiseFault name="RF-Key-Identity-Mismatch" continueOnError="false" enabled="true">
  <DisplayName>RF-Key-Identity-Mismatch</DisplayName>
  <!-- Enforces key-to-identity binding when the API product or developer app
       declares an owner_identity attribute: the verified caller identity claim
       (iss#sub) must match the owner bound to the API key. -->
  <FaultResponse>
    <Set>
      <StatusCode>403</StatusCode>
      <Payload contentType="application/json">{"error":"key_identity_mismatch","detail":"The API key owner_identity does not match the caller's verified identity claim."}</Payload>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
