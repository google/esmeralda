<RaiseFault name="RF-Target-Not-Allowed" continueOnError="false" enabled="true">
  <DisplayName>RF-Target-Not-Allowed</DisplayName>
  <FaultResponse>
    <Set>
      <StatusCode>403</StatusCode>
      <Payload contentType="application/json">{"error":"target_not_allowed","detail":"The requested project, location or model is not allowed through the model gateway."}</Payload>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
