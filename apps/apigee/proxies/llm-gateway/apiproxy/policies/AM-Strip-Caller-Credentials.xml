<AssignMessage name="AM-Strip-Caller-Credentials" continueOnError="false" enabled="true">
  <DisplayName>AM-Strip-Caller-Credentials</DisplayName>
  <!-- The caller's ID token stops at the gateway: Vertex AI gets the proxy service account's
       access token (GoogleAccessToken on the target), never the caller's credential. -->
  <Remove>
    <Headers>
      <Header name="Authorization"/>
      <Header name="X-Forwarded-Authorization"/>
      <Header name="x-api-key"/>
      <Header name="x-goog-api-key"/>
      <Header name="x-goog-user-project"/>
    </Headers>
  </Remove>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
