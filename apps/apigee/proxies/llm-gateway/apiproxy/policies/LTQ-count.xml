<LLMTokenQuota name="LTQ-count" continueOnError="true" enabled="true">
  <DisplayName>LTQ-count</DisplayName>
  <SharedName>esmeralda-llm-gateway-quota</SharedName>
  <CountOnly>true</CountOnly>
  <Identifier ref="llmgw.caller.principal"/>
  <Allow count="1000000" countRef="llmgw.quota.limit"/>
  <Interval>1</Interval>
  <TimeUnit ref="llmgw.quota.timeunit">minute</TimeUnit>
  <LLMModelSource>{llm.request.model}</LLMModelSource>
  <Distributed>true</Distributed>
  <Synchronous>true</Synchronous>
  <LLMTokenUsageSource>{llm.totalTokenCount}</LLMTokenUsageSource>
</LLMTokenQuota>
