<RaiseFault name="RF-Not-Found" continueOnError="false" enabled="true">
  <DisplayName>RF-Not-Found</DisplayName>
  <FaultResponse>
    <Set>
      <StatusCode>404</StatusCode>
      <Payload contentType="application/json">{"error":"not_found","detail":"Only POST generateContent, streamGenerateContent and countTokens on Vertex AI publisher models are served."}</Payload>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
