<RaiseFault name="RF-Agent-Not-Allowed" continueOnError="false" enabled="true">
  <DisplayName>RF-Agent-Not-Allowed</DisplayName>
  <!-- Enforces the server-side partner agent allowlist derived from the service
       catalog (expose_to_partners = true, e.g. cx-mortgage-orchestrator). Direct
       partner requests to internal specialist agents are rejected at the gateway. -->
  <FaultResponse>
    <Set>
      <StatusCode>403</StatusCode>
      <Payload contentType="application/json">{"error":"agent_not_allowed","detail":"The requested agent is not exposed to external partner consumers."}</Payload>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
