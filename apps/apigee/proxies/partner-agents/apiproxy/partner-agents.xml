<APIProxy revision="1" name="partner-agents">
  <DisplayName>partner-agents</DisplayName>
  <Description>North-south partner front door for allowlisted Esmeralda agents (SSE and JSON routes separated).</Description>
  <BasePaths>/partner/v1/agents</BasePaths>
  <Policies>
    <Policy>AM-Strip-Verified-Headers</Policy>
    <Policy>AM-clean-headers</Policy>
    <Policy>AM-set-user-var</Policy>
    <Policy>EV-ExtractTokenCount</Policy>
    <Policy>FC-Cross-Cloud</Policy>
    <Policy>JS-extract-tokens</Policy>
    <Policy>JS-rewrite-target-path</Policy>
    <Policy>KVM-Get-Agent-Config</Policy>
    <Policy>LTQ-count</Policy>
    <Policy>LTQ-enforce</Policy>
    <Policy>ML-interaction</Policy>
    <Policy>RF-Agent-Not-Allowed</Policy>
    <Policy>RF-Key-Identity-Mismatch</Policy>
    <Policy>RF-Not-Found</Policy>
    <Policy>VAK-Verify-Partner-Key</Policy>
  </Policies>
  <ProxyEndpoints>
    <ProxyEndpoint>default</ProxyEndpoint>
  </ProxyEndpoints>
  <Resources>
    <Resource>jsc://extract-tokens.js</Resource>
    <Resource>jsc://rewrite-target-path.js</Resource>
  </Resources>
  <TargetEndpoints>
    <TargetEndpoint>default</TargetEndpoint>
    <TargetEndpoint>sse</TargetEndpoint>
  </TargetEndpoints>
</APIProxy>
