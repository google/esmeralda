<TargetEndpoint name="default">
  <Description>Non-streaming TargetEndpoint for /v1/card, :query, and /v1/message:send with Content-Type guarded token extraction.</Description>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>JS-rewrite-target-path</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step>
        <Name>EV-ExtractTokenCount</Name>
        <Condition>!(response.header.Content-Type =| "text/event-stream")</Condition>
      </Step>
      <Step>
        <Name>JS-extract-tokens</Name>
        <Condition>!(response.header.Content-Type =| "text/event-stream")</Condition>
      </Step>
      <Step>
        <Name>LTQ-count</Name>
        <Condition>!(response.header.Content-Type =| "text/event-stream") and (llm.totalTokenCount != null)</Condition>
      </Step>
    </Response>
  </PostFlow>
  <Flows/>
  <HTTPTargetConnection>
    <LoadBalancer>
      <Server name="ts-esmeralda-entrypoint"/>
    </LoadBalancer>
    <Path>{esmeralda.target.path}</Path>
    <Properties>
      <Property name="io.timeout.millis">300000</Property>
      <Property name="api.timeout">300000</Property>
    </Properties>
    <SSLInfo>
      <Enabled>true</Enabled>
      <Enforce>true</Enforce>
      <IgnoreValidationErrors>false</IgnoreValidationErrors>
    </SSLInfo>
    <Authentication>
      <GoogleAccessToken>
        <Scopes>
          <Scope>https://www.googleapis.com/auth/cloud-platform</Scope>
        </Scopes>
      </GoogleAccessToken>
    </Authentication>
  </HTTPTargetConnection>
</TargetEndpoint>
