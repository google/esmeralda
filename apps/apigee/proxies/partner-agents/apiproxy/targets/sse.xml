<TargetEndpoint name="sse">
  <Description>Dedicated SSE TargetEndpoint for :streamQuery and /v1/message:stream (never mixes buffered JSON extraction with EventFlow streaming).</Description>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request/>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <Flows/>
  <EventFlow name="EventFlow" content-type="text/event-stream">
    <Response>
      <Step>
        <Name>JS-extract-tokens</Name>
      </Step>
      <Step>
        <Name>LTQ-count</Name>
        <Condition>isFinal = true</Condition>
      </Step>
    </Response>
  </EventFlow>
  <HTTPTargetConnection>
    <LoadBalancer>
      <Server name="ts-esmeralda-entrypoint"/>
    </LoadBalancer>
    <Path>/v1/agents</Path>
    <Properties>
      <Property name="response.streaming.enabled">true</Property>
      <Property name="io.timeout.millis">300000</Property>
      <Property name="api.timeout">300000</Property>
    </Properties>
    <SSLInfo>
      <Enabled>true</Enabled>
      <Enforce>true</Enforce>
      <IgnoreValidationErrors>false</IgnoreValidationErrors>
    </SSLInfo>
    <Authentication>
      <GoogleAccessToken>
        <Scopes>
          <Scope>https://www.googleapis.com/auth/cloud-platform</Scope>
        </Scopes>
      </GoogleAccessToken>
    </Authentication>
  </HTTPTargetConnection>
</TargetEndpoint>
