# ==============================================================================
# Esmeralda Monorepo - Local Development & Integration Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# GCP & Vertex AI Configuration
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=esm-dev-ai-coe-agents
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# ------------------------------------------------------------------------------
# Agent Settings & Models
# ------------------------------------------------------------------------------
MODEL_NAME=gemini-3.7-flash
AGENT_NAME=ai-coe-mortgage-specialist

# ------------------------------------------------------------------------------
# MCP Service Endpoints (Private DNS esmeralda.internal vs Local Dev)
# ------------------------------------------------------------------------------
# Private DNS routing strings (one host per service on the gateway entry point,
# <name>.esmeralda.internal):
DMS_MCP_URL=http://legacy-dms.esmeralda.internal/mcp
INCOME_VERIFICATION_URL=http://income-verification.esmeralda.internal/mcp
EMAIL_MCP_URL=http://corporate-email.esmeralda.internal/mcp

# For local uvicorn development:
# DMS_MCP_URL=http://localhost:8003/mcp
# INCOME_VERIFICATION_URL=http://localhost:8002/mcp
# EMAIL_MCP_URL=http://localhost:8001/mcp

# ------------------------------------------------------------------------------
# Authentication & Execution Flags
# ------------------------------------------------------------------------------
# Set to 'true' when running against local uvicorn servers (bypasses IAM token generation)
LOCAL_MODE=false
# Deprecated opt-in: service account impersonated for outgoing calls (ID tokens and access
# tokens). Leave empty to call out as the runtime identity (on Agent Runtime, the agent's own
# Agent Identity).
SERVICE_ACCOUNT_EMAIL=
# Hosts that take an OAuth2 access token instead of an ID token (comma-separated;
# *.googleapis.com always does). Set per agent by Terraform from the service catalog.
# ACCESS_TOKEN_HOSTS=

# ------------------------------------------------------------------------------
# Vertex AI Reasoning Engine Resource IDs (Populated after terraform apply)
# ------------------------------------------------------------------------------
A2A_REASONING_ENGINE_ID=
ROOT_REASONING_ENGINE_ID=

# ------------------------------------------------------------------------------
# Telemetry & BigQuery Logging
# ------------------------------------------------------------------------------
EVENTS_DATASET_ID=esmeralda_telemetry_logs_dev
EVENTS_TABLE_ID=ai_coe_mortgage_specialist_events
GCS_BUCKET=
