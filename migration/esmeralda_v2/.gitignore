# ===========================================================================
# Esmeralda v2: Git Ignore Specifications
# ===========================================================================

# --- Local Python Virtual Environments & Packages ---
.venv/
.venv*
venv/
env/
.uv/
uv.lock

# --- Python Bytecodes & Cache Files ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- Local Credentials & Environment Variables ---
.env
.env.*
!.env.example
*.tfvars
*.tfvars.json

# --- Terraform & Terragrunt Run Caches ---
.terraform/
.terragrunt-cache/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfplan
.local_states/


# --- System and IDE Overrides ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-*
*.swp
*.swo
