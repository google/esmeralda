# --- 1. User Infrastructure Input ---
# Your Google Cloud Organization ID (numeric)
ORG_ID=your-org-id
# The Billing Account ID to associate with the new project
BILLING_ACCOUNT=your-billing-account
# The desired base name for your new project
PROJECT_ID_BASE=agent-ops-foundation
# A descriptive name for your Vertex AI Agent instance
AGENT_NAME=base-adk-agent
# The GCP region for all resources
REGION=us-central1

# --- 2. Active Deployment Context (System Managed) ---
# These are automatically populated by the deployment scripts,
# but can be manually overridden if needed.

# The final PROJECT_ID (may include a random suffix)
# PROJECT_ID=agent-ops-foundation-xxxx

# The Service Account used by the Agent
# SERVICE_ACCOUNT_EMAIL=vertex-agent-sa@...

# The name of the GCS bucket for logs offload
# GCS_OFFLOAD_BUCKET_NAME=...

# The Vertex AI Reasoning Engine Resource ID for load testing
# REMOTE_AGENT_ENGINE_ID=projects/your-project-id/locations/us-central1/reasoningEngines/your-engine-id
